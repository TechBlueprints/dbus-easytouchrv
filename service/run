#!/bin/sh
echo "*** starting dbus-easytouchrv ***"
exec 2>&1
. /etc/profile.d/profile.sh

# Brief delay on restart to allow D-Bus name release from previous instance
sleep 3

echo "Starting EasyTouch RV thermostat manager..."
cd /data/apps/dbus-easytouchrv

# Shared BCM install: the /data/bcm shim serves the fleet-wide BLE stack and
# marks this a deliberate consumer (BCM_AUTOWIRE=0).  A standalone install
# without the shared checkout falls back to plain python3, which uses this
# repo's vendored ext/ stack instead.
BCM_PY=/data/bcm/python3
[ -x "$BCM_PY" ] || BCM_PY=python3
exec softlimit -d 150000000 -s 2000000 -a 150000000 "$BCM_PY" -u dbus-easytouchrv.py
